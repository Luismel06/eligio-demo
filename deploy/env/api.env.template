# For a Vercel API project, configure these values in Vercel Environment Variables.
# For a separate container deployment, store the file outside Git with mode 0600.
# Supply real values through the approved secret channel; never commit them.
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGIN=
NODE_ENV=production
TRUST_PROXY=1
API_PORT=4000
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
TAX_IDENTITY_OVERRIDE_RATE_LIMIT_WINDOW_MS=900000
TAX_IDENTITY_OVERRIDE_RATE_LIMIT_MAX=5
TAX_IDENTITY_APPROVAL_REQUEST_RATE_LIMIT_WINDOW_MS=900000
TAX_IDENTITY_APPROVAL_REQUEST_RATE_LIMIT_MAX=20
TAX_IDENTITY_APPROVAL_REQUEST_READ_RATE_LIMIT_WINDOW_MS=900000
TAX_IDENTITY_APPROVAL_REQUEST_READ_RATE_LIMIT_MAX=300
TAX_IDENTITY_APPROVAL_REQUEST_TTL_MINUTES=30
DGII_REGISTRY_MAX_AGE_HOURS=216
DGII_REGISTRY_RETAIN_SUPERSEDED_DATASETS=1
DGII_REGISTRY_IMPORT_STALE_HOURS=24
TAX_IDENTITY_HMAC_SECRET=
API_JSON_BODY_LIMIT=20mb
API_FORM_BODY_LIMIT=20mb
INTERNAL_ALLOWED_IPS=
MOBILE_OCR_PUBLIC_RATE_LIMIT_WINDOW_MS=600000
MOBILE_OCR_PUBLIC_RATE_LIMIT_MAX=30
