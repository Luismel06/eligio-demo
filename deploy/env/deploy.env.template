# For Vercel, configure these values in the separate web and API projects.
# Use only domains owned for this demo; never reuse RIVNU/CoreStack production domains.
# NEXT_PUBLIC_APP_URL=https://YOUR_ELIGIO_WEB_DOMAIN
# NEXT_PUBLIC_API_URL=https://YOUR_ELIGIO_API_DOMAIN
# Leave INTERNAL_ALLOWED_IPS empty for authenticated public access.
RIVNU_IMAGE_TAG=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_API_URL=
INTERNAL_ALLOWED_IPS=

# Resource budget per production project. The defaults cap the API + Web pair
# at 1 GiB and 1 CPU, so four projects can coexist on a 4-vCPU / 8-GiB VM2.
RIVNU_API_CPUS=0.65
RIVNU_API_MEMORY_LIMIT=512m
RIVNU_API_MEMORY_SWAP_LIMIT=512m
RIVNU_API_MEMORY_RESERVATION=192m
RIVNU_API_PIDS_LIMIT=128
RIVNU_WEB_CPUS=0.35
RIVNU_WEB_MEMORY_LIMIT=512m
RIVNU_WEB_MEMORY_SWAP_LIMIT=512m
RIVNU_WEB_MEMORY_RESERVATION=128m
RIVNU_WEB_PIDS_LIMIT=128

# Docker's local log driver rotates these files automatically.
RIVNU_LOG_MAX_SIZE=10m
RIVNU_LOG_MAX_FILES=3
