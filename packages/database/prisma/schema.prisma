generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  INVITED
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
  DISABLED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  ACCOUNTANT
  CASHIER
  ORDER_TAKER
  QORVEX_SUPER_ADMIN
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum InventoryMovementType {
  INITIAL_STOCK
  PURCHASE
  INBOUND
  OUTBOUND
  ADJUSTMENT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  SALE
  RETURN
  DAMAGE
  TRANSFER_IN
  TRANSFER_OUT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  CANCELLED
  VOIDED
  CREDITED
  VOID
  PENDING_ECF
  ACCEPTED
  REJECTED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHECK
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CREATED
  SENT_TO_CASHIER
  IN_CASHIER
  QUOTATION
  COMPLETED
  CANCELLED
  EXPIRED
}

enum SalesOrderDestination {
  CASH_SALE
  QUOTATION
}

enum SalesOrderPriceLevel {
  REGULAR
  DISCOUNT_10
  PREFERRED_18
}

enum ReturnRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum ElectronicDocumentProvider {
  MOCK
  GAE
  DGII
  DGII_DIRECT
}

enum ElectronicDocumentStatus {
  PENDING
  PROCESSING
  SIGNED
  SENT
  ACCEPTED
  REJECTED
  FAILED
  CANCELLED
}

enum DocumentType {
  RNC
  CEDULA
  PASSPORT
  CONSUMER_FINAL
  OTHER
}

enum DgiiRegistrySource {
  DGII_OFFICIAL
  TEST_FIXTURE
}

enum DgiiRegistryDatasetStatus {
  IMPORTING
  READY
  ACTIVE
  SUPERSEDED
  FAILED
}

enum DgiiTaxpayerStatus {
  ACTIVE
  SUSPENDED
  DEREGISTERED
  TEMPORARY_CESSATION
  ANNULLED
  REJECTED
  UNKNOWN
}

enum TaxIdentityContextType {
  POS_ORDER
  CUSTOMER
  SUPPLIER
  CUSTOMER_CREATE
  SUPPLIER_CREATE
}

enum TaxIdentityApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum InvoiceFiscalStatus {
  NOT_APPLICABLE
  PENDING_SEQUENCE
  LOCAL_ISSUED
  LEGACY_UNVERIFIED
  READY_TO_SEND
  PENDING_SIGNATURE
  SIGNED
  SENT
  ACCEPTED
  REJECTED
  FAILED
  CANCELLED
}

enum InvoiceDocumentType {
  CONSUMER_02
  FISCAL_CREDIT_01
  CONSUMER_ELECTRONIC_32
  FISCAL_CREDIT_ELECTRONIC_31
  DEBIT_NOTE_ELECTRONIC_33
  CREDIT_NOTE_ELECTRONIC_34
}

enum FiscalDocumentPurpose {
  CONSUMER
  FISCAL_CREDIT
}

enum FiscalIssuanceMode {
  LOCAL_NCF
  ELECTRONIC_ECF
}

enum BarcodeType {
  EAN13
  UPC_A
  CODE128
  INTERNAL_CODE128
  QR
  UNKNOWN
}

enum ProductUnit {
  UNIT
  BOX
  PACK
  BAG
  ROLL
  METER
  FOOT
  YARD
  POUND
  GALLON
  LITER
  KILOGRAM
  QUINTAL
  SERVICE
}

enum TaxCategory {
  ITBIS_18
  ITBIS_16
  EXEMPT
}

enum CashRegisterStatus {
  ACTIVE
  INACTIVE
}

enum CashSessionStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum CashMovementType {
  OPENING
  SALE_PAYMENT
  CREDIT_PAYMENT
  SUPPLIER_PAYMENT
  CASH_IN
  CASH_OUT
  REFUND
  CLOSING
  ADJUSTMENT
}

enum EmployeeLogAction {
  OPEN_CASH_SESSION
  CLOSE_CASH_SESSION
  CREATE_SALES_ORDER
  SEND_SALES_ORDER_TO_CASHIER
  CLAIM_SALES_ORDER
  RELEASE_SALES_ORDER
  COMPLETE_SALES_ORDER
  CANCEL_SALES_ORDER
  EXPIRE_SALES_ORDER
  CREATE_SALE
  CANCEL_SALE
  ISSUE_INVOICE
  CANCEL_INVOICE
  APPLY_DISCOUNT
  CHANGE_PRODUCT_PRICE
  ADD_PRODUCT
  UPDATE_PRODUCT
  DELETE_PRODUCT
  CHANGE_BARCODE
  PRINT_RECEIPT
  REPRINT_RECEIPT
  CASH_IN
  CASH_OUT
  INVENTORY_ADJUSTMENT
  REQUEST_RETURN
  APPROVE_RETURN
  REJECT_RETURN
  COMPLETE_RETURN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  TERMINATED
}

enum FiscalSequenceStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  EXHAUSTED
}

enum ImportType {
  PRODUCTS
  CATEGORIES
  CUSTOMERS
  INITIAL_INVENTORY
  FISCAL_SEQUENCES
  HISTORICAL_INVOICES
  INVOICE_ITEMS
  PAYMENTS
}

enum ImportStatus {
  DRAFT
  VALIDATING
  READY
  IMPORTED
  FAILED
  CANCELLED
}

enum ImportRowStatus {
  IMPORTED
  FAILED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseOrderStatus {
  DRAFT
  REQUESTED
  UNDER_REVIEW
  APPROVED
  ISSUED
  PARTIALLY_RECEIVED
  RECEIVED
  PAUSED
  CANCELLED
}

enum SupplierInvoiceStatus {
  DRAFT
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum GoodsReceiptStatus {
  DRAFT
  CONFIRMED
  REVERSED
  CANCELLED
}

enum SalePaymentMode {
  CASH
  CREDIT
}

enum InitialPaymentOption {
  NONE
  PERCENT_30
  PERCENT_50
  PERCENT_70
}

enum CreditTermOption {
  CUSTOMER_DEFAULT
  DAYS_15
  DAYS_30
  DAYS_45
  CUSTOM_DATE
}

enum CustomerCreditStatus {
  ACTIVE
  BLOCKED
}

enum CreditApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum SupplierInvoiceAttachmentSource {
  CAMERA
  UPLOAD
}

enum OcrStatus {
  NOT_REQUESTED
  PROCESSING
  REVIEW_REQUIRED
  FAILED
  CONFIRMED
}

/// Temporary OCR capture started on a desktop and completed on a phone.
/// The session is deleted after it is consumed or cancelled.
enum MobileOcrCaptureStatus {
  PENDING
  READY
}

enum ReceiptPriceDecision {
  KEEP
  RECALCULATE_MARGIN
  MANUAL
}

enum Currency {
  DOP
}

model Tenant {
  id                          String                       @id @default(cuid())
  name                        String
  commercialName              String?
  legalName                   String?
  slug                        String                       @unique
  rnc                         String?
  email                       String?
  phone                       String?
  address                     String?
  fiscalIssuanceMode          FiscalIssuanceMode           @default(LOCAL_NCF)
  status                      TenantStatus                 @default(ACTIVE)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  branding                    CompanyBranding?
  memberships                 Membership[]
  customers                   Customer[]
  categories                  ProductCategory[]
  products                    Product[]
  inventoryMovements          InventoryMovement[]
  invoices                    Invoice[]
  payments                    Payment[]
  electronicDocuments         ElectronicDocument[]
  auditLogs                   AuditLog[]
  employeeProfiles            EmployeeProfile[]
  cashRegisters               CashRegister[]
  cashSessions                CashSession[]
  cashMovements               CashMovement[]
  employeeActivityLogs        EmployeeActivityLog[]
  salesOrders                 SalesOrder[]
  returnRequests              ReturnRequest[]
  fiscalSequences             FiscalSequence[]
  importBatches               ImportBatch[]
  suppliers                   Supplier[]
  supplierProducts            SupplierProduct[]
  purchaseOrders              PurchaseOrder[]
  purchaseOrderItems          PurchaseOrderItem[]
  purchaseOrderEvents         PurchaseOrderEvent[]
  supplierInvoices            SupplierInvoice[]
  supplierInvoiceItems        SupplierInvoiceItem[]
  supplierInvoiceAttachments  SupplierInvoiceAttachment[]
  supplierPayments            SupplierPayment[]
  goodsReceipts               GoodsReceipt[]
  goodsReceiptItems           GoodsReceiptItem[]
  creditSaleApprovals         CreditSaleApproval[]
  mobileOcrCaptureSessions    MobileOcrCaptureSession[]
  taxIdentityOverrides        TaxIdentityOverride[]
  taxIdentityApprovalRequests TaxIdentityApprovalRequest[]

  @@index([status])
  @@index([createdAt])
}

model CompanyBranding {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  logoUrl       String?
  primaryColor  String?
  accentColor   String?
  loginTitle    String?
  loginSubtitle String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model User {
  id                                  String                       @id @default(cuid())
  email                               String                       @unique
  name                                String
  phone                               String?
  passwordHash                        String?
  status                              UserStatus                   @default(ACTIVE)
  createdAt                           DateTime                     @default(now())
  updatedAt                           DateTime                     @updatedAt
  memberships                         Membership[]
  auditLogs                           AuditLog[]
  employeeProfiles                    EmployeeProfile[]
  invoicesIssued                      Invoice[]                    @relation("InvoiceIssuedBy")
  inventoryMovementsCreated           InventoryMovement[]          @relation("InventoryMovementCreatedBy")
  payments                            Payment[]
  salesOrdersCreated                  SalesOrder[]                 @relation("SalesOrderCreatedBy")
  salesOrdersCompleted                SalesOrder[]                 @relation("SalesOrderCompletedBy")
  salesOrdersClaimed                  SalesOrder[]                 @relation("SalesOrderClaimedBy")
  cashSessionsOpened                  CashSession[]                @relation("CashSessionOpenedBy")
  cashSessionsClosed                  CashSession[]                @relation("CashSessionClosedBy")
  cashMovements                       CashMovement[]
  employeeActivityLogs                EmployeeActivityLog[]
  importBatches                       ImportBatch[]
  returnRequestsRequested             ReturnRequest[]              @relation("ReturnRequestRequestedBy")
  returnRequestsApproved              ReturnRequest[]              @relation("ReturnRequestApprovedBy")
  returnRequestsRejected              ReturnRequest[]              @relation("ReturnRequestRejectedBy")
  customersCreditEnabled              Customer[]                   @relation("CustomerCreditEnabledBy")
  suppliersCreated                    Supplier[]                   @relation("SupplierCreatedBy")
  suppliersUpdated                    Supplier[]                   @relation("SupplierUpdatedBy")
  suppliersDeactivated                Supplier[]                   @relation("SupplierDeactivatedBy")
  supplierProductsCreated             SupplierProduct[]            @relation("SupplierProductCreatedBy")
  supplierProductsUpdated             SupplierProduct[]            @relation("SupplierProductUpdatedBy")
  purchaseOrdersCreated               PurchaseOrder[]              @relation("PurchaseOrderCreatedBy")
  purchaseOrdersRequested             PurchaseOrder[]              @relation("PurchaseOrderRequestedBy")
  purchaseOrdersReviewed              PurchaseOrder[]              @relation("PurchaseOrderReviewedBy")
  purchaseOrdersApproved              PurchaseOrder[]              @relation("PurchaseOrderApprovedBy")
  purchaseOrdersIssued                PurchaseOrder[]              @relation("PurchaseOrderIssuedBy")
  purchaseOrdersPaused                PurchaseOrder[]              @relation("PurchaseOrderPausedBy")
  purchaseOrdersCancelled             PurchaseOrder[]              @relation("PurchaseOrderCancelledBy")
  purchaseOrderEvents                 PurchaseOrderEvent[]
  supplierInvoicesCreated             SupplierInvoice[]            @relation("SupplierInvoiceCreatedBy")
  supplierInvoicesUpdated             SupplierInvoice[]            @relation("SupplierInvoiceUpdatedBy")
  supplierInvoicesCancelled           SupplierInvoice[]            @relation("SupplierInvoiceCancelledBy")
  supplierInvoiceAttachmentsUploaded  SupplierInvoiceAttachment[]  @relation("SupplierInvoiceAttachmentUploadedBy")
  supplierInvoiceAttachmentsConfirmed SupplierInvoiceAttachment[]  @relation("SupplierInvoiceAttachmentConfirmedBy")
  supplierPaymentsCreated             SupplierPayment[]            @relation("SupplierPaymentCreatedBy")
  supplierPaymentsCancelled           SupplierPayment[]            @relation("SupplierPaymentCancelledBy")
  goodsReceiptsCreated                GoodsReceipt[]               @relation("GoodsReceiptCreatedBy")
  goodsReceiptsConfirmed              GoodsReceipt[]               @relation("GoodsReceiptConfirmedBy")
  goodsReceiptsReversed               GoodsReceipt[]               @relation("GoodsReceiptReversedBy")
  goodsReceiptsCancelled              GoodsReceipt[]               @relation("GoodsReceiptCancelledBy")
  creditSaleApprovalsRequested        CreditSaleApproval[]         @relation("CreditSaleApprovalRequestedBy")
  creditSaleApprovalsApproved         CreditSaleApproval[]         @relation("CreditSaleApprovalApprovedBy")
  creditSaleApprovalsRejected         CreditSaleApproval[]         @relation("CreditSaleApprovalRejectedBy")
  creditSaleApprovalsCancelled        CreditSaleApproval[]         @relation("CreditSaleApprovalCancelledBy")
  paymentsCancelled                   Payment[]                    @relation("PaymentCancelledBy")
  mobileOcrCaptureSessionsCreated     MobileOcrCaptureSession[]    @relation("MobileOcrCaptureCreatedBy")
  taxIdentityOverridesRequested       TaxIdentityOverride[]        @relation("TaxIdentityOverrideRequestedBy")
  taxIdentityOverridesApproved        TaxIdentityOverride[]        @relation("TaxIdentityOverrideApprovedBy")
  taxIdentityApprovalRequestsCreated  TaxIdentityApprovalRequest[] @relation("TaxIdentityApprovalRequestCreatedBy")
  taxIdentityApprovalRequestsDecided  TaxIdentityApprovalRequest[] @relation("TaxIdentityApprovalRequestDecidedBy")

  @@index([status])
  @@index([createdAt])
}

model Membership {
  id                       String           @id @default(cuid())
  userId                   String
  tenantId                 String
  role                     Role
  status                   MembershipStatus @default(ACTIVE)
  canUsePos                Boolean          @default(false)
  canOpenCashSession       Boolean          @default(false)
  canCloseCashSession      Boolean          @default(false)
  canApplyDiscount         Boolean          @default(false)
  canCancelInvoice         Boolean          @default(false)
  canVoidInvoice           Boolean          @default(false)
  canAdjustInventory       Boolean          @default(false)
  canManageProducts        Boolean          @default(false)
  canManageEmployees       Boolean          @default(false)
  canViewReports           Boolean          @default(false)
  canManageFiscalSequences Boolean          @default(false)
  canViewCashLogs          Boolean          @default(false)
  canReprintReceipt        Boolean          @default(false)
  canTakeOrders            Boolean          @default(false)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  user                     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant                   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId, status])
  @@index([userId])
}

model Customer {
  id                      String               @id @default(cuid())
  tenantId                String
  name                    String
  documentType            DocumentType
  documentNumber          String?
  email                   String?
  phone                   String?
  address                 String?
  status                  CustomerStatus       @default(ACTIVE)
  creditEnabled           Boolean              @default(false)
  creditLimit             Decimal              @default(0) @db.Decimal(14, 2)
  creditBalance           Decimal              @default(0) @db.Decimal(14, 2)
  creditTermDays          Int                  @default(30)
  creditStatus            CustomerCreditStatus @default(BLOCKED)
  creditEnabledAt         DateTime?
  creditEnabledById       String?
  taxIdentityVerification Json?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  creditEnabledBy         User?                @relation("CustomerCreditEnabledBy", fields: [creditEnabledById], references: [id], onDelete: SetNull)
  invoices                Invoice[]
  salesOrders             SalesOrder[]
  creditSaleApprovals     CreditSaleApproval[]

  @@unique([tenantId, documentType, documentNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, creditEnabled, creditStatus])
  @@index([creditEnabledById])
  @@index([createdAt])
}

model ProductCategory {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    Product[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([createdAt])
}

model Product {
  id                     String                @id @default(cuid())
  tenantId               String
  categoryId             String?
  name                   String
  sku                    String?
  barcode                String?
  barcodeType            BarcodeType?
  generatedBarcode       Boolean               @default(false)
  barcodeLabelPrintedAt  DateTime?
  barcodeLabelPrintCount Int                   @default(0)
  barcodeLastScannedAt   DateTime?
  barcodeCreatedById     String?
  description            String?
  imageUrl               String?
  brand                  String?
  unit                   ProductUnit           @default(UNIT)
  price                  Decimal               @db.Decimal(12, 2)
  salePrice              Decimal               @default(0) @db.Decimal(12, 2)
  cost                   Decimal?              @db.Decimal(12, 2)
  costWithTax            Decimal?              @db.Decimal(14, 2)
  margin                 Decimal?              @db.Decimal(8, 4)
  taxCategory            TaxCategory           @default(ITBIS_18)
  taxRate                Decimal               @default(0.18) @db.Decimal(5, 4)
  trackInventory         Boolean               @default(true)
  stock                  Float                 @default(0)
  reservedStock          Float                 @default(0)
  minStock               Float                 @default(0)
  status                 ProductStatus         @default(ACTIVE)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  tenant                 Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category               ProductCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  inventoryMovements     InventoryMovement[]
  invoiceItems           InvoiceItem[]
  salesOrderItems        SalesOrderItem[]
  returnRequestItems     ReturnRequestItem[]
  supplierProducts       SupplierProduct[]
  purchaseOrderItems     PurchaseOrderItem[]
  supplierInvoiceItems   SupplierInvoiceItem[]
  goodsReceiptItems      GoodsReceiptItem[]
  importRows             ImportBatchRow[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, sku])
  @@index([tenantId, stock])
  @@index([createdAt])
}

model InventoryMovement {
  id                String                @id @default(cuid())
  tenantId          String
  productId         String
  type              InventoryMovementType
  quantity          Float
  previousStock     Float?
  newStock          Float?
  unitCost          Decimal?              @db.Decimal(12, 2)
  reason            String?
  reference         String?
  invoiceId         String?
  supplierInvoiceId String?
  goodsReceiptId    String?
  createdById       String?
  createdAt         DateTime              @default(now())
  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product           Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  invoice           Invoice?              @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  supplierInvoice   SupplierInvoice?      @relation(fields: [supplierInvoiceId], references: [id], onDelete: SetNull)
  goodsReceipt      GoodsReceipt?         @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)
  createdBy         User?                 @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([productId])
  @@index([invoiceId])
  @@index([supplierInvoiceId])
  @@index([goodsReceiptId])
  @@index([createdById])
}

model Invoice {
  id                        String                @id @default(cuid())
  tenantId                  String
  customerId                String?
  documentType              InvoiceDocumentType   @default(CONSUMER_02)
  invoiceNumber             String
  ncf                       String?
  eNcf                      String?
  fiscalSequenceId          String?
  fiscalAuthorizationNumber String?
  fiscalValidUntil          DateTime?             @db.Date
  fiscalIssuerSnapshot      Json?
  fiscalCustomerSnapshot    Json?
  status                    InvoiceStatus         @default(DRAFT)
  fiscalStatus              InvoiceFiscalStatus   @default(NOT_APPLICABLE)
  subtotal                  Decimal               @default(0) @db.Decimal(12, 2)
  taxTotal                  Decimal               @default(0) @db.Decimal(12, 2)
  discountTotal             Decimal               @default(0) @db.Decimal(12, 2)
  total                     Decimal               @default(0) @db.Decimal(12, 2)
  paidAmount                Decimal               @default(0) @db.Decimal(12, 2)
  amountReceived            Decimal               @default(0) @db.Decimal(12, 2)
  changeAmount              Decimal               @default(0) @db.Decimal(12, 2)
  balance                   Decimal               @default(0) @db.Decimal(12, 2)
  paymentMode               SalePaymentMode       @default(CASH)
  paymentMethod             PaymentMethod?
  issuedById                String?
  cashSessionId             String?
  issuedAt                  DateTime?
  dueDate                   DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  tenant                    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer                  Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  issuedBy                  User?                 @relation("InvoiceIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)
  cashSession               CashSession?          @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  fiscalSequence            FiscalSequence?       @relation(fields: [tenantId, fiscalSequenceId], references: [tenantId, id], onDelete: Restrict)
  items                     InvoiceItem[]
  payments                  Payment[]
  electronicDocument        ElectronicDocument?
  inventoryMovements        InventoryMovement[]
  cashMovements             CashMovement[]
  employeeActivityLogs      EmployeeActivityLog[]
  salesOrder                SalesOrder?
  returnRequests            ReturnRequest[]

  @@unique([tenantId, invoiceNumber])
  @@unique([tenantId, ncf])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, paymentMode, dueDate])
  @@index([tenantId, createdAt])
  @@index([issuedById])
  @@index([cashSessionId])
  @@index([fiscalSequenceId])
}

model InvoiceItem {
  id                 String              @id @default(cuid())
  invoiceId          String
  productId          String?
  sku                String?
  barcode            String?
  description        String
  quantity           Decimal             @db.Decimal(12, 2)
  unit               ProductUnit         @default(UNIT)
  unitPrice          Decimal             @db.Decimal(12, 2)
  discountTotal      Decimal             @default(0) @db.Decimal(12, 2)
  taxCategory        TaxCategory         @default(ITBIS_18)
  taxRate            Decimal             @db.Decimal(5, 4)
  taxTotal           Decimal             @default(0) @db.Decimal(12, 2)
  subtotal           Decimal             @db.Decimal(12, 2)
  total              Decimal             @db.Decimal(12, 2)
  invoice            Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product            Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  returnRequestItems ReturnRequestItem[]

  @@index([invoiceId])
  @@index([productId])
}

model SalesOrder {
  id                         String                @id @default(cuid())
  tenantId                   String
  customerId                 String?
  destination                SalesOrderDestination @default(CASH_SALE)
  fiscalPurpose              FiscalDocumentPurpose @default(CONSUMER)
  fiscalDocumentTypeSnapshot InvoiceDocumentType   @default(CONSUMER_02)
  fiscalCustomerSnapshot     Json?
  clientName                 String?
  quotationDocumentType      DocumentType?
  quotationDocumentNumber    String?
  orderNumber                String
  status                     SalesOrderStatus      @default(SENT_TO_CASHIER)
  priceLevel                 SalesOrderPriceLevel  @default(REGULAR)
  discountRate               Decimal               @default(0) @db.Decimal(5, 4)
  subtotal                   Decimal               @default(0) @db.Decimal(12, 2)
  taxTotal                   Decimal               @default(0) @db.Decimal(12, 2)
  discountTotal              Decimal               @default(0) @db.Decimal(12, 2)
  total                      Decimal               @default(0) @db.Decimal(12, 2)
  paymentMode                SalePaymentMode       @default(CASH)
  initialPaymentOption       InitialPaymentOption?
  initialPaymentRate         Decimal               @default(0) @db.Decimal(5, 4)
  initialPaymentAmount       Decimal               @default(0) @db.Decimal(14, 2)
  creditTermOption           CreditTermOption?
  creditTermDays             Int?
  dueDate                    DateTime?
  creditRequestNote          String?
  notes                      String?
  createdById                String
  completedById              String?
  claimedById                String?
  claimedCashSessionId       String?
  invoiceId                  String?               @unique
  sentToCashierAt            DateTime?
  claimedAt                  DateTime?
  claimExpiresAt             DateTime?
