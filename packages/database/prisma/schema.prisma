  cashSession         CashSession?        @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  items               ReturnRequestItem[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([invoiceId])
  @@index([requestedById])
  @@index([approvedById])
  @@index([rejectedById])
  @@index([cashSessionId])
  @@index([createdAt])
}

model ReturnRequestItem {
  id              String        @id @default(cuid())
  returnRequestId String
  invoiceItemId   String
  productId       String?
  description     String
  quantity        Decimal       @db.Decimal(12, 2)
  unitPrice       Decimal       @db.Decimal(12, 2)
  discountTotal   Decimal       @default(0) @db.Decimal(12, 2)
  taxRate         Decimal       @db.Decimal(5, 4)
  taxTotal        Decimal       @default(0) @db.Decimal(12, 2)
  subtotal        Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  restock         Boolean       @default(true)
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  invoiceItem     InvoiceItem   @relation(fields: [invoiceItemId], references: [id], onDelete: Restrict)
  product         Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([returnRequestId])
  @@index([invoiceItemId])
  @@index([productId])
}

model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  invoiceId     String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(PENDING)
  receiptNumber String?
  userId        String?
  cashSessionId String?
  cancelledById String?
  cancelledAt   DateTime?
  cancelReason  String?
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  cashSession   CashSession?  @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  cancelledBy   User?         @relation("PaymentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([invoiceId])
  @@index([userId])
  @@index([cashSessionId])
  @@index([cancelledById])
}

model ElectronicDocument {
  id              String                     @id @default(cuid())
  tenantId        String
  invoiceId       String                     @unique
  provider        ElectronicDocumentProvider
  status          ElectronicDocumentStatus   @default(PENDING)
  xmlUrl          String?
  pdfUrl          String?
  trackId         String?
  externalId      String?
  errorMessage    String?
  requestPayload  Json?
  responsePayload Json?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  tenant          Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice         Invoice                    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model EmployeeProfile {
  id                    String         @id @default(cuid())
  tenantId              String
  userId                String
  employeeCode          String?
  jobTitle              String?
  hireDate              DateTime?
  documentType          DocumentType?
  documentNumber        String?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  notes                 String?
  status                EmployeeStatus @default(ACTIVE)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@unique([tenantId, employeeCode])
  @@index([tenantId, status])
  @@index([userId])
}

model CashRegister {
  id        String             @id @default(cuid())
  tenantId  String
  name      String
  location  String?
  status    CashRegisterStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions  CashSession[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model CashSession {
  id                   String                @id @default(cuid())
  tenantId             String
  cashRegisterId       String
  openedById           String
  closedById           String?
  status               CashSessionStatus     @default(OPEN)
  openingAmount        Decimal               @default(0) @db.Decimal(12, 2)
  closingAmount        Decimal?              @db.Decimal(12, 2)
  expectedAmount       Decimal?              @db.Decimal(12, 2)
  difference           Decimal?              @db.Decimal(12, 2)
  openedAt             DateTime              @default(now())
  closedAt             DateTime?
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashRegister         CashRegister          @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  openedBy             User                  @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy             User?                 @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  movements            CashMovement[]
  invoices             Invoice[]
  payments             Payment[]
  employeeActivityLogs EmployeeActivityLog[]
  claimedSalesOrders   SalesOrder[]          @relation("SalesOrderClaimedCashSession")
  returnRequests       ReturnRequest[]
  supplierPayments     SupplierPayment[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([openedById])
  @@index([cashRegisterId])
}

model CashMovement {
  id                String           @id @default(cuid())
  tenantId          String
  cashSessionId     String
  userId            String
  type              CashMovementType
  amount            Decimal          @db.Decimal(12, 2)
  method            PaymentMethod?
  reason            String?
  reference         String?
  invoiceId         String?
  supplierPaymentId String?
  createdAt         DateTime         @default(now())
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashSession       CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  supplierPayment   SupplierPayment? @relation(fields: [supplierPaymentId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([cashSessionId])
  @@index([userId])
  @@index([invoiceId])
  @@index([supplierPaymentId])
  @@index([tenantId, createdAt])
}

model EmployeeActivityLog {
  id            String            @id @default(cuid())
  tenantId      String
  userId        String
  cashSessionId String?
  action        EmployeeLogAction
  entity        String
  entityId      String?
  amount        Decimal?          @db.Decimal(12, 2)
  metadata      Json?
  ip            String?
  userAgent     String?
  invoiceId     String?
  createdAt     DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  cashSession   CashSession?      @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  invoice       Invoice?          @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([cashSessionId])
  @@index([action])
  @@index([tenantId, createdAt])
}

model FiscalSequence {
  id                  String               @id @default(cuid())
  tenantId            String
  documentType        InvoiceDocumentType
  prefix              String
  startNumber         Int
  endNumber           Int
  nextNumber          Int
  authorizationNumber String?
  issuerTaxId         String?
  validUntil          DateTime?            @db.Date
  status              FiscalSequenceStatus @default(ACTIVE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoices            Invoice[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, documentType, status])
}

model ImportBatch {
  id           String           @id @default(cuid())
  tenantId     String
  type         ImportType
  filename     String
  status       ImportStatus     @default(DRAFT)
  totalRows    Int              @default(0)
  validRows    Int              @default(0)
  invalidRows  Int              @default(0)
  importedRows Int              @default(0)
  createdById  String?
  createdAt    DateTime         @default(now())
  confirmedAt  DateTime?
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  errors       ImportRowError[]
  rows         ImportBatchRow[]

  @@index([tenantId])
  @@index([tenantId, type, status])
  @@index([createdById])
}

model ImportRowError {
  id            String      @id @default(cuid())
  importBatchId String
  rowNumber     Int
  field         String?
  message       String
  rawData       Json?
  importBatch   ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  @@index([importBatchId])
  @@index([rowNumber])
}

model ImportBatchRow {
  id            String          @id @default(cuid())
  importBatchId String
  rowNumber     Int
  status        ImportRowStatus
  productId     String?
  productLabel  String?
  rawData       Json
  reasons       Json?
  createdAt     DateTime        @default(now())
  importBatch   ImportBatch     @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([importBatchId, rowNumber])
  @@index([importBatchId, status, rowNumber])
  @@index([productId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

/// One immutable import attempt of the official DGII taxpayer registry.
/// Records are loaded while IMPORTING and only become visible after an atomic
/// status switch to ACTIVE. At most one ACTIVE dataset is enforced in SQL.
model DgiiRegistryDataset {
  id                 String                    @id @default(cuid())
  version            String                    @unique
  source             DgiiRegistrySource
  status             DgiiRegistryDatasetStatus @default(IMPORTING)
  filename           String?
  checksumSha256     String?                   @unique
  sourceUpdatedAt    DateTime
  startedAt          DateTime                  @default(now())
  importedAt         DateTime?
  activatedAt        DateTime?
  deactivatedAt      DateTime?
  recordCount        Int                       @default(0)
  invalidRecordCount Int                       @default(0)
  failureCode        String?
  records            DgiiTaxpayerRecord[]

  @@index([status])
  @@index([source, sourceUpdatedAt])
  @@index([activatedAt])
}

/// Taxpayer data is deliberately limited to the fields needed for identity
/// validation. Raw DGII rows and reserved columns are never persisted.
model DgiiTaxpayerRecord {
  datasetId      String
  documentType   DocumentType
  documentNumber String
  fiscalName     String
  registryStatus String
  status         DgiiTaxpayerStatus
  dataset        DgiiRegistryDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@id([datasetId, documentType, documentNumber])
  @@index([datasetId, status])
}

/// A short-lived administrative authorization for an identity that cannot be
/// verified against a fresh DGII dataset. The document is bound by HMAC; only
/// its last four digits are retained for support/audit display.
model TaxIdentityOverride {
  id               String                       @id @default(cuid())
  tenantId         String
  contextType      TaxIdentityContextType
  contextId        String
  documentType     DocumentType
  documentHash     String                       @db.VarChar(64)
  documentLast4    String                       @db.VarChar(4)
  fiscalName       String
  reason           String
  requestedById    String
  approvedById     String
  expiresAt        DateTime
  revokedAt        DateTime?
  usedAt           DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  tenant           Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy      User                         @relation("TaxIdentityOverrideRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy       User                         @relation("TaxIdentityOverrideApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  approvalRequests TaxIdentityApprovalRequest[]

  @@index([tenantId, contextType, contextId, documentHash, expiresAt])
  @@index([requestedById])
  @@index([approvedById])
  @@index([expiresAt])
  @@index([usedAt])
}

/// A cashier/user request for an administrator to authorize a fiscal identity
/// that could not be verified against the current DGII registry. Only the
/// normalized fields needed for the decision are stored; no raw DGII response
/// is persisted.
model TaxIdentityApprovalRequest {
  id                      String                           @id @default(cuid())
  tenantId                String
  contextType             TaxIdentityContextType
  contextId               String
  documentType            DocumentType
  documentNumber          String                           @db.VarChar(11)
  documentHash            String                           @db.VarChar(64)
  documentLast4           String                           @db.VarChar(4)
  fiscalName              String
  reason                  String?
  registryOutcome         String                           @db.VarChar(32)
  registrySource          DgiiRegistrySource?
  registryCheckedAt       DateTime
  registrySourceUpdatedAt DateTime?
  status                  TaxIdentityApprovalRequestStatus @default(PENDING)
  requestedById           String
  decidedById             String?
  overrideId              String?
  requestedAt             DateTime                         @default(now())
  expiresAt               DateTime
  decidedAt               DateTime?
  decisionNote            String?
  updatedAt               DateTime                         @updatedAt
  tenant                  Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy             User                             @relation("TaxIdentityApprovalRequestCreatedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy               User?                            @relation("TaxIdentityApprovalRequestDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  override                TaxIdentityOverride?             @relation(fields: [overrideId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, requestedAt])
  @@index([tenantId, contextType, contextId, documentHash], map: "TaxIdentityApprovalRequest_context_document_idx")
  @@index([requestedById, status])
  @@index([decidedById])
  @@index([overrideId])
  @@index([expiresAt])
}
